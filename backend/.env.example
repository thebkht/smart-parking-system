# Backend configuration. Copy to backend/.env (gitignored) and adjust as needed.

# Authentication is OFF by default — the backend runs unauthenticated, which is
# intended for local development and demos only.
#
# Set AUTH_ENABLED to 1/true/yes to require a bearer token on owner routes and
# scope Find My Car sessions to their owner. Tokens are issued at runtime via
# POST /auth/register (no secret needs to be configured here).
AUTH_ENABLED=
