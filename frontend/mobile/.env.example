# API base URL for the Smart Parking System backend.
# In Expo Go the bundler host is auto-detected from Constants.expoConfig.hostUri —
# you only need this if auto-detection fails or you want to point at a different host.
# Use the backend machine's LAN IP (not 127.0.0.1 — that's the phone itself):
#   EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000
EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000
